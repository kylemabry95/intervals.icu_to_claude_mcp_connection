#!/bin/bash
################################################################################
# packaging/macos/install.sh.test
#
# Local testing harness for install.sh installation script.
#
# This test file allows developers to validate install.sh behavior locally
# without requiring a mounted DMG or user interaction.
#
# Usage:
#   ./packaging/macos/install.sh.test              # Run all tests
#   ./packaging/macos/install.sh.test --help       # Show help
#   ./packaging/macos/install.sh.test --setup      # Create test environment
#   ./packaging/macos/install.sh.test --clean      # Clean up test artifacts
#
# Features:
#   - Creates mock app bundle for testing
#   - Simulates various error conditions
#   - Validates error handling and messaging
#   - Tests argument parsing
#
################################################################################
set -euo pipefail

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly TEST_DIR="${SCRIPT_DIR}/.test"
readonly MOCK_APP_NAME="IntervalsICU"
readonly MOCK_APP_BUNDLE="${MOCK_APP_NAME}.app"
readonly MOCK_DMG_MOUNT="${TEST_DIR}/mock_mount"
readonly TEST_DEST="${TEST_DIR}/Applications"

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

# Test counters
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0

# ────────────────────────────────────────────────────────────────────────────
# UTILITY FUNCTIONS
# ────────────────────────────────────────────────────────────────────────────

echo_test() { echo -e "${BLUE}[TEST]${NC} $*"; }
echo_pass() { echo -e "${GREEN}[PASS]${NC} $*"; TESTS_PASSED=$((TESTS_PASSED + 1)); }
echo_fail() { echo -e "${RED}[FAIL]${NC} $*"; TESTS_FAILED=$((TESTS_FAILED + 1)); }
echo_skip() { echo -e "${YELLOW}[SKIP]${NC} $*"; }

# Setup test environment
setup_test_env() {
    echo_test "Setting up test environment..."
    
    # Clean any previous test artifacts
    rm -rf "${TEST_DIR}"
    mkdir -p "${TEST_DEST}" "${MOCK_DMG_MOUNT}"
    
    # Create mock app bundle
    create_mock_app_bundle
    
    echo_pass "Test environment ready"
}

# Create a minimal mock app bundle
create_mock_app_bundle() {
    local app_path="${MOCK_DMG_MOUNT}/${MOCK_APP_BUNDLE}"
    
    mkdir -p "${app_path}/Contents/MacOS"
    mkdir -p "${app_path}/Contents/Resources"
    
    # Create minimal Info.plist
    cat > "${app_path}/Contents/Info.plist" << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>IntervalsICU</string>
    <key>CFBundleIdentifier</key>
    <string>com.intervalsicu.desktop</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>IntervalsICU</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
</dict>
</plist>
EOF
    
    # Create minimal executable
    cat > "${app_path}/Contents/MacOS/IntervalsICU" << 'EOF'
#!/bin/bash
echo "Mock IntervalsICU executable"
EOF
    chmod +x "${app_path}/Contents/MacOS/IntervalsICU"
    
    # Add quarantine attribute for testing
    xattr -w com.apple.quarantine "0001;0;0" "${app_path}" 2>/dev/null || true
}

# Clean up test environment
cleanup_test_env() {
    echo_test "Cleaning up test environment..."
    
    # Remove test directory
    rm -rf "${TEST_DIR}"
    
    echo_pass "Test environment cleaned"
}

# ────────────────────────────────────────────────────────────────────────────
# TEST SUITES
# ────────────────────────────────────────────────────────────────────────────

# Test: Source code syntax
test_syntax() {
    echo_test "Testing shell script syntax..."
    TESTS_RUN=$((TESTS_RUN + 1))
    
    if bash -n "${SCRIPT_DIR}/install.sh" 2>/dev/null; then
        echo_pass "Shell syntax valid"
    else
        echo_fail "Shell syntax error"
    fi
}

# Test: Help output
test_help() {
    echo_test "Testing --help flag..."
    TESTS_RUN=$((TESTS_RUN + 1))
    
    if bash "${SCRIPT_DIR}/install.sh" --help 2>&1 | grep -q "USAGE:"; then
        echo_pass "Help output valid"
    else
        echo_fail "Help output missing"
    fi
}

# Test: Version output
test_version() {
    echo_test "Testing --version flag..."
    TESTS_RUN=$((TESTS_RUN + 1))
    
    if bash "${SCRIPT_DIR}/install.sh" --version 2>&1 | grep -q "Installation Script"; then
        echo_pass "Version output valid"
    else
        echo_fail "Version output missing"
    fi
}

# Test: Invalid arguments
test_invalid_args() {
    echo_test "Testing invalid arguments..."
    TESTS_RUN=$((TESTS_RUN + 1))
    
    if bash "${SCRIPT_DIR}/install.sh" --invalid-flag 2>&1 | grep -q "Unknown option"; then
        echo_pass "Invalid argument handling correct"
    else
        echo_fail "Invalid argument not handled"
    fi
}

# Test: Fresh installation
test_fresh_install() {
    echo_test "Testing fresh installation..."
    TESTS_RUN=$((TESTS_RUN + 1))
    
    # Run install script pointing to our mock app and test destination
    local app_exists=false
    
    if [[ -d "${MOCK_DMG_MOUNT}/${MOCK_APP_BUNDLE}" ]]; then
        app_exists=true
    fi
    
    if $app_exists; then
        echo_pass "Mock app bundle found"
    else
        echo_fail "Mock app bundle not found"
    fi
}

# Test: Mock app structure
test_app_structure() {
    echo_test "Testing mock app bundle structure..."
    TESTS_RUN=$((TESTS_RUN + 1))
    
    local app="${MOCK_DMG_MOUNT}/${MOCK_APP_BUNDLE}"
    local executable="${app}/Contents/MacOS/IntervalsICU"
    
    if [[ -x "${executable}" ]]; then
        echo_pass "App bundle structure valid"
    else
        echo_fail "App bundle structure invalid"
    fi
}

# Test: Quarantine attribute detection
test_quarantine_detection() {
    echo_test "Testing quarantine attribute detection..."
    TESTS_RUN=$((TESTS_RUN + 1))
    
    local app="${MOCK_DMG_MOUNT}/${MOCK_APP_BUNDLE}"
    
    if xattr -l "${app}" 2>/dev/null | grep -q "com.apple.quarantine"; then
        echo_pass "Quarantine attribute present (as expected)"
    else
        echo_skip "Quarantine attribute not present (may be normal)"
    fi
}

# Test: Shellcheck linting (if available)
test_shellcheck() {
    if ! command -v shellcheck &> /dev/null; then
        echo_skip "shellcheck not available (install with: brew install shellcheck)"
        return
    fi
    
    echo_test "Running shellcheck linting..."
    TESTS_RUN=$((TESTS_RUN + 1))
    
    if shellcheck -x "${SCRIPT_DIR}/install.sh" 2>&1 | head -5 > /tmp/shellcheck.log; then
        echo_pass "Shellcheck passed"
    else
        echo_fail "Shellcheck issues found (see /tmp/shellcheck.log)"
        cat /tmp/shellcheck.log
    fi
}

# ────────────────────────────────────────────────────────────────────────────
# MAIN TEST RUNNER
# ────────────────────────────────────────────────────────────────────────────

run_all_tests() {
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "IntervalsICU install.sh Test Suite"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    
    setup_test_env
    echo ""
    
    # Run test suites
    test_syntax
    test_help
    test_version
    test_invalid_args
    test_app_structure
    test_fresh_install
    test_quarantine_detection
    test_shellcheck
    
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo "Test Results: ${TESTS_RUN} run, ${TESTS_PASSED} passed, ${TESTS_FAILED} failed"
    echo "═══════════════════════════════════════════════════════════════"
    echo ""
    
    # Cleanup
    cleanup_test_env
    
    # Return appropriate exit code
    if [[ ${TESTS_FAILED} -eq 0 ]]; then
        echo_pass "All tests passed!"
        return 0
    else
        echo_fail "Some tests failed"
        return 1
    fi
}

# ────────────────────────────────────────────────────────────────────────────
# ENTRY POINT
# ────────────────────────────────────────────────────────────────────────────

main() {
    case "${1:-}" in
        --help)
            cat << 'EOF'
install.sh Test Suite

USAGE:
  ./install.sh.test [COMMAND]

COMMANDS:
  (default)  Run all tests
  --help     Show this help message
  --setup    Create test environment
  --clean    Clean up test artifacts

EXAMPLES:
  ./install.sh.test              # Run all tests
  ./install.sh.test --setup      # Prepare test environment
  ./install.sh.test --clean      # Clean up

For more information, see packaging/macos/README.md
EOF
            ;;
        --setup)
            setup_test_env
            ;;
        --clean)
            cleanup_test_env
            ;;
        *)
            run_all_tests
            ;;
    esac
}

main "$@"
