<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for hardened runtime (necessary for notarization and code signing) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    
    <!-- Allow JIT compilation for Python and interpreters -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    
    <!-- Allow accessing Keychain for secure credential storage -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.intervalsicu.desktop</string>
    </array>
    
    <!-- Allow network connections (required for API calls to intervals.icu and Anthropic) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    
    <!-- Allow reading/writing to user's application support directory -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Allow access to home directory for preferences and logs -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/Library/Preferences/</string>
        <string>/Library/Application Support/IntervalsICU/</string>
        <string>/Library/Logs/IntervalsICU/</string>
    </array>
    
    <!-- Required for Python subprocess spawning (MCP server process) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
